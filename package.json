{
  "name": "itaska",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["api"],
  "scripts": {
    "start": "node api/index.js",
    "dev": "PORT=3001 node api/index.js",
    "migrate": "node api/migrate.js",
